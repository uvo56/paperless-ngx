# Secrets - nie committen, stattdessen die *.example-Dateien pflegen
.env
paperless-extra.env
*.key
*.pem

# Dokumente, Datenbank-Hilfsdaten, Eingangsordner und Backups
data/
consume/
backups/
*.log

# Status der Backup-Dienste; Ordner bleibt im Repo, damit Docker ihn nicht als root anlegt
backup-status/*
!backup-status/.gitkeep
