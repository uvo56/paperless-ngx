# Optionale Zusatzfunktionen von Paperless. Zum Aktivieren:
#   cp paperless-extra.env.example paperless-extra.env && chmod 600 paperless-extra.env
# gewünschte Zeilen einkommentieren, dann: docker compose up -d
# Die Datei paperless-extra.env wird NIE committet (kann Passwörter enthalten).

# --- Mailversand (Passwort zurücksetzen, Dokumente per Mail senden, Workflows) ---
# PAPERLESS_EMAIL_HOST=smtp.example.de
# PAPERLESS_EMAIL_PORT=587
# PAPERLESS_EMAIL_USE_TLS=true
# PAPERLESS_EMAIL_HOST_USER=paperless@example.de
# PAPERLESS_EMAIL_HOST_PASSWORD=CHANGE_ME
# PAPERLESS_EMAIL_FROM=paperless@example.de

# --- KI-Vorschläge über den LOKALEN Ollama-Host (keine Cloud-Dienste!) ---------
# PAPERLESS_AI_ENABLED=true
# PAPERLESS_AI_LLM_BACKEND=ollama
# PAPERLESS_AI_LLM_ENDPOINT=http://OLLAMA_HOST:11434
# PAPERLESS_AI_LLM_MODEL=MODELLNAME
# PAPERLESS_AI_LLM_EMBEDDING_BACKEND=ollama
# PAPERLESS_AI_LLM_EMBEDDING_MODEL=MODELLNAME
# PAPERLESS_AI_LLM_OUTPUT_LANGUAGE=de
