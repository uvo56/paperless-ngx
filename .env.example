# Vorlage für die Konfiguration. Kopieren nach .env und Platzhalter ersetzen:
#   cp .env.example .env && chmod 600 .env && nano .env
# Die .env enthält Zugangsdaten und wird NIE committet.
# Passwörter/Schlüssel erzeugen z. B. mit: openssl rand -base64 48 | tr -d '/+='

# --- Allgemein ---------------------------------------------------------------
TZ=Europe/Berlin
# Benutzer-/Gruppen-ID, der die Dateien in data/, consume/ und backups/ gehören (siehe: id)
APP_UID=1001
APP_GID=1001

# --- Paperless ---------------------------------------------------------------
# Adresse, unter der Paperless im LAN erreichbar ist (ohne / am Ende)
PAPERLESS_URL=http://DOCKER_HOST_IP:8000
PAPERLESS_PORT=8000
# Name in der Oberfläche (z. B. "Paperless TEST" während der Testphase)
PAPERLESS_APP_TITLE=Paperless-ngx
PAPERLESS_SECRET_KEY=CHANGE_ME
# Admin-Benutzer, wird beim ersten Start angelegt
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME
# 0 = Consume-Ordner sofort überwachen (lokaler Ordner).
# Liegt consume/ auf einer SMB/NFS-Freigabe: Abfrageintervall in Sekunden, z. B. 30
PAPERLESS_CONSUMER_POLLING_INTERVAL=0

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME

# --- Backup (Container db-backup und export-backup) --------------------------
# Uhrzeit des täglichen Backups (HH:MM, Ortszeit)
BACKUP_TIME=01:30
# Wie viele Tage Datenbank-Dumps aufbewahrt werden
BACKUP_RETENTION_DAYS=30

# --- Offsite-Backup auf NAS (Container nas-sync) ------------------------------
# Ordner, unter dem der NAS-Share auf dem Host eingebunden ist (/etc/fstab)
NAS_MOUNT=/mnt/backup-dhost
# Uhrzeit der täglichen Kopie (HH:MM) – nach dem lokalen Backup
NAS_SYNC_TIME=02:30
